{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": [
      "node"
    ]
  },
  "//": "No DOM lib. core/ is pure (spec \u00a711.4), so reaching for document here is a compile error rather than a code review note.",
  "include": [
    "src/core/**/*.js",
    "test/**/*.js",
    "tools/**/*.js"
  ],
  "exclude": [
    "test/browser/**",
    "test/sidecar-store.test.js",
    "test/file-store.test.js"
  ]
}
