{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Planner",
  "version": "0.1.0",
  "identifier": "io.hammock.planner",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "resources": ["../themes"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
