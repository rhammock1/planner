{
  "name": "planner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A macOS menu bar daily planner",
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "serve": "node tools/serve.js",
    "rebuild": "tools/rebuild",
    "app": "PATH=\"$HOME/.cargo/bin:$PATH\" CARGO_TARGET_DIR=\"$HOME/.cache/planner-target\" cargo run --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
